rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // users/{userId}: uid, displayName, age, gender, heightCm, weightKg, coins, onboarded
    // tamagotchi/{userId}: petType, petChosen, name, level, xp, totalKm, hunger, happiness, energy
    // challenges_progress/{userId}: completedDays, currentDay, streak, habitCue
    // workouts/{workoutId}: userId, distanceKm, calories, elapsedSeconds, workoutCategory
    // ===============================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isValidUser() {
      return request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasAll(['uid', 'displayName']);
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidUser();
      allow delete: if false;
    }

    match /tamagotchi/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /challenges_progress/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /workouts/{workoutId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // 구독 권한은 결제 검증을 마친 Cloud Functions(Admin SDK)만 씁니다.
    // Admin SDK는 이 규칙을 우회하므로, 클라이언트 쓰기를 전부 막아도 서버는 정상 동작합니다.
    // 클라이언트가 쓸 수 있으면 PRO를 무료로 발급하는 것과 같습니다.
    match /subscriptions/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    // 결제 주문 기록도 서버 전용입니다. 클라이언트는 열람할 필요가 없습니다.
    match /payment_orders/{orderId} {
      allow read, write: if false;
    }
  }
}
