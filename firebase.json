{
  "hosting": {
    "site": "runnow-37af9",
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**/*.@(html|js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "firestore": {
    "database": "(default)",
    "location": "asia-northeast3",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "auth": {
    "providers": {
      "emailPassword": true,
      "googleSignIn": {
        "oAuthBrandDisplayName": "RUNNOW",
        "supportEmail": "dnswlq456@gmail.com",
        "authorizedRedirectUris": [
          "https://runnow-37af9.web.app",
          "https://runnow-37af9.firebaseapp.com",
          "http://localhost"
        ]
      }
    }
  }
}
